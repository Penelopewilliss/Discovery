# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Google Maps API key — needed for the map to render on Android & iOS.
# Enable these APIs in Google Cloud Console for this key:
#   - Maps SDK for Android
#   - Maps SDK for iOS
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Places API key (New) — enables rich place search & photos.
# Falls back to Wikipedia + OpenStreetMap if not set.
# Enable: Places API (New)
EXPO_PUBLIC_GOOGLE_PLACES_KEY=your_google_places_api_key_here

# Google OAuth client IDs — needed for Firebase Google sign-in.
# The web client ID is also used as the Expo Go fallback.
# Enable Google as a Firebase Authentication sign-in provider first.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id_here
