rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function onlyFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    || (isAuth() && onlyFields(['likedPostIds', 'savedPostIds', 'reactionsByPost', 'hasAutoFollowedDemoUsers']));
      allow delete: if isOwner(uid);
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuth();
      allow create, update: if isAuth()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth()
                    && (resource.data.userId == request.auth.uid
                        || onlyFields(['likesCount', 'commentsCount', 'reactions']));
      allow delete: if isOwner(resource.data.userId);

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth()
                      && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(resource.data.userId);
      }
    }

    // ── Stories ───────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read, write: if isAuth();
    }

    // ── Follows ───────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // ── Messages / Conversations ──────────────────────────────────────────────
    match /conversations/{convoId} {
      allow read, write: if isAuth();

      match /messages/{msgId} {
        allow read, write: if isAuth();
      }
    }

    // ── Groups ────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;

      match /trips/{tripId} {
        allow read, write: if isAuth();

        match /entries/{entryId} {
          allow read, write: if isAuth();
        }
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, write: if isAuth();
    }

    // ── Friends ───────────────────────────────────────────────────────────────
    match /friends/{friendId} {
      allow read: if isAuth();
      allow create: if isAuth()
                    && (request.resource.data.requestedBy == request.auth.uid);
      allow update: if isAuth()
                    && (resource.data.userId1 == request.auth.uid
                        || resource.data.userId2 == request.auth.uid);
      allow delete: if isAuth()
                    && (resource.data.userId1 == request.auth.uid
                        || resource.data.userId2 == request.auth.uid);
    }
  }
}

